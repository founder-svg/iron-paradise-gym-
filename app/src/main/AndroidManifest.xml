<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".IronParadiseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appName}"
        android:supportsRtl="true"
        android:theme="@style/Theme.IronParadiseGymCRM">

        <!-- Login / PIN Authentication Launcher -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.stock.StockInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.stock.StockLedgerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.stock.StockAdjustmentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.sales.NewSaleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.invoices.InvoiceDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.products.ProductsListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.products.AddEditProductActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.products.ProductDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customers.CustomersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customers.CustomerDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reports.ReportsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.more.StaffManagementActivity"
            android:exported="false" />

        <!-- FileProvider for PDF Invoice Sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
