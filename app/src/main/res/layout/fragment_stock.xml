<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INVENTORY"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStockInHeader"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="+ Stock In"
                android:textColor="@color/bg_black"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_green"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_secondary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Search supplements, brand, category..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_card_elevated"
                android:paddingHorizontal="12dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filter Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:checked="true"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProtein"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protein"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCreatine"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Creatine"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBcaa"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BCAA"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOthers"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Others"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipInStock"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Stock"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLowStock"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low Stock"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/accent_gold" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOutOfStock"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Out of Stock"
                    app:chipBackgroundColor="@color/bg_card_elevated"
                    android:textColor="@color/accent_red" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- View Mode Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleViewMode"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                app:singleSelection="true"
                app:checkedButton="@id/btnViewTable">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewTable"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="📊 Table View"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewCards"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="🗂️ Cards View"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTableScrollHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scroll ↔ for full table"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 1. Table View (Matches user spreadsheet format) -->
        <HorizontalScrollView
            android:id="@+id/hsvInventoryTable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Table Header Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="center"
                        android:text="Sr.no"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="center"
                        android:text="Date"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="145dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="start|center_vertical"
                        android:paddingStart="8dp"
                        android:text="Product"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="center"
                        android:text="Quantity"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="end|center_vertical"
                        android:paddingEnd="8dp"
                        android:text="Price"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="end|center_vertical"
                        android:paddingEnd="8dp"
                        android:text="Total"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_table_header_cell"
                        android:gravity="center"
                        android:text="Balance"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Table Content RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInventoryTable"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 2. Product Cards View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyStock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No records matching filter."
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <!-- FAB for quick product / stock add (Mockup Screen 4) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Add Product"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/accent_gold"
        app:tint="@color/bg_black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
