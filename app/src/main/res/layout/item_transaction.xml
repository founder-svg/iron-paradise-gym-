<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp"
    app:cardCornerRadius="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Left Status Icon (Mockup Screen 3 & 10) -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_tx_icon_green"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivTransactionIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                app:tint="@color/accent_green"
                android:contentDescription="Transaction Type" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Whey Protein"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTransactionMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="07 Oct 2026"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Quantity Movement Badge -->
            <TextView
                android:id="@+id/tvQuantityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+5 Stock In"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_in_stock"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- Remaining Balance Indicator -->
            <TextView
                android:id="@+id/tvBalanceRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bal: 18 units"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
