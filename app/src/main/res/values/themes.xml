<resources>
    <!-- Base Application Theme -->
    <style name="Theme.IronParadiseGymCRM" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorPrimaryVariant">@color/bg_card_elevated</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        
        <!-- Secondary / Accent -->
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorSecondaryVariant">@color/accent_gold_dark</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        
        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_black</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_black</item>

        <!-- Component Styles -->
        <item name="cardViewStyle">@style/IronCardView</item>
        <item name="textInputStyle">@style/IronTextInput</item>
        <item name="materialButtonStyle">@style/IronButtonPrimary</item>
    </style>

    <style name="IronCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="IronTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="IronButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/text_primary</item>
        <item name="android:textColor">@color/bg_black</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="IronButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
